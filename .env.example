# --- LLM provider (OpenAI-compatible) ---------------------------------------
# When set, the agent uses this endpoint for planning/answering.
# When unset, a deterministic scripted/heuristic provider is used (CI/demo mode).
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Task-based routing (optional): strongest model for PLANNER, cheap model for
# REASONER/ANSWERER/CLAIMER. Empty = use OPENAI_MODEL for everything.
OPENAI_MODEL_PLANNER=
OPENAI_MODEL_FAST=
# Fine-tuned model goes here once trained, e.g. ft:gpt-4.1-mini:...:ara-planner
# OPENAI_MODEL_PLANNER=ft:gpt-4.1-mini:your-org:ara-planner:<id>
# Comma-separated fallback models tried in order on provider errors.
OPENAI_FALLBACK_MODELS=

# --- ColPali visual retrieval service ---------------------------------------
COLPALI_SERVICE_URL=http://localhost:8100
COLPALI_MODE=mock            # mock | real  (real requires GPU + colpali-engine)

# --- Storage backends (pluggable) -------------------------------------------
DATABASE_URL=sqlite:///./data/ara.db          # or postgresql://user:pass@host/db
REDIS_URL=                                    # e.g. redis://localhost:6379/0 (optional)
QDRANT_URL=                                   # e.g. http://localhost:6333 (optional)

# --- Security ----------------------------------------------------------------
# Comma-separated list of SHA-256 hashes of API keys; a plaintext dev key is
# auto-provisioned and printed at startup when ARA_DEV_API_KEY is empty.
ARA_API_KEY_SHA256=
ARA_DEV_API_KEY=ara-dev-key-change-me
ARA_SECRET_KEY=change-me-32-bytes-min

# --- Budgets (defaults; overridable per request) ------------------------------
ARA_DEFAULT_TIME_BUDGET_S=120
ARA_DEFAULT_MAX_TOOL_CALLS=24
ARA_DEFAULT_MAX_LLM_CALLS=16
ARA_DEFAULT_MAX_TOKENS=120000
ARA_DEFAULT_MAX_COST_USD=2.00

# --- Pricing for cost accounting (USD per 1K tokens) --------------------------
ARA_PRICE_INPUT_PER_1K=0.0005
ARA_PRICE_OUTPUT_PER_1K=0.0015

# --- Runtime ------------------------------------------------------------------
ARA_LOG_LEVEL=INFO
ARA_ENV=development
